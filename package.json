{
  "name": "@lanjak/council",
  "version": "0.6.1",
  "description": "Multi-LLM adversarial review council - an AXI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "council": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "smoke": "./scripts/smoke-package.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.6",
    "openai": "^4.90.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "publint": "^0.3.22",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "axi",
    "llm",
    "council",
    "adversarial-review",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanjak/council.git"
  }
}
